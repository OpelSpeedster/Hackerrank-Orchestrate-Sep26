# Groq models. The reasoning model is used as the safety/orchestration reviewer.
GROQ_API_KEY="your-groq-api-key"
EXTRACTION_MODEL="qwen/qwen3.8-27b"
REASONING_MODEL="meta-llama/llama-prompt-guard-2-86m"

# Optional Modal document/embedding endpoint. Keep credentials in .env only.
MODAL_API_KEY="your-modal-api-key"
MODAL_ENDPOINT="https://modal.com/apps/vishalsv2205/main"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Pipeline controls
MAX_CONCURRENCY="4"
AGENT_MAX_STEPS="8"
GROQ_TIMEOUT_SECONDS="30"
MODAL_TIMEOUT_SECONDS="30"
FAISS_INDEX_PATH="artifacts/financial.faiss"
GROQ_ENABLE_AGENT="1"

